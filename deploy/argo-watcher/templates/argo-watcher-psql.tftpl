apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: argo-watcher-psql
  namespace: argo-cd
  labels:
    managed-by: terraform
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: registry-1.docker.io/bitnamicharts
    chart: postgresql
    targetRevision: "18.8.8"
    helm:
      valuesObject:
        fullnameOverride: argo-watcher-psql
        # Bitnami publishes only the mutable `latest` tag for its free catalogue, so
        # both images are pinned by digest; the server digest is PostgreSQL 18.6.0.
        # Refresh both when bumping targetRevision.
        image:
          digest: "sha256:ac3fdcc36145212217d968ecdc84475749083a8c7f04723d40f7f7aa9ba3abda"
        volumePermissions:
          image:
            digest: "sha256:2e8c230fc67796bd6c54a47d94ebe7f2b42b331858829d71d3b0fe0f8e9aabf6"
        tls:
          enabled: true
          autoGenerated: true
        auth:
          enablePostgresUser: false
          username: watcher
          database: watcher
          existingSecret: ${secretName}
        primary:
          persistence:
            enabled: true
            size: 1Gi
          persistentVolumeClaimRetentionPolicy:
            enabled: true
            whenDeleted: Delete

  destination:
    server: https://kubernetes.default.svc
    namespace: ${namespace}

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
