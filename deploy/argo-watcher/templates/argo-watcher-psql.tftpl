apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: argo-watcher-psql
  namespace: argo-cd
  labels:
    managed-by: terraform
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  # Delivered through the raw chart so Argo CD retries until the operator has
  # registered the CRD; kubernetes_manifest would need it to exist at plan time.
  source:
    repoURL: https://bedag.github.io/helm-charts
    chart: raw
    targetRevision: "${rawChartVersion}"
    helm:
      valuesObject:
        resources:
          - apiVersion: acid.zalan.do/v1
            kind: postgresql
            metadata:
              name: ${clusterName}
              namespace: ${namespace}
            spec:
              teamId: ${teamId}
              numberOfInstances: 1
              postgresql:
                version: "${postgresVersion}"
              volume:
                size: 1Gi
              users:
                ${user}: []
              databases:
                ${database}: ${user}

  destination:
    server: https://kubernetes.default.svc
    namespace: ${namespace}

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    # targetRevision is pinned, so a sync that lands before the operator has
    # registered the CRD is only reattempted because of this retry block.
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 2
        maxDuration: 3m
    syncOptions:
      - ServerSideApply=true
